{
  "name": "@tlberglund/handwriting-react",
  "version": "0.1.0",
  "description": "React component for handwriting animation",
  "main": "dist/handwriting-react.esm.js",
  "module": "dist/handwriting-react.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/handwriting-react.esm.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "author": "Tim Berglund <tlberglund@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tlberglund/animated-handwriting"
  },
  "keywords": ["handwriting", "animation", "react", "canvas", "typescript"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/handwriting-react.esm.js --format=esm --external:react --external:react-dom --external:@tlberglund/handwriting-playback",
    "build:types": "tsc --emitDeclarationOnly",
    "watch": "esbuild src/index.ts --bundle --outfile=dist/handwriting-react.esm.js --format=esm --external:react --external:react-dom --external:@tlberglund/handwriting-playback --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@tlberglund/handwriting-playback": "^0.1.0"
  },
  "devDependencies": {
    "@tlberglund/handwriting-playback": "file:../playback",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
