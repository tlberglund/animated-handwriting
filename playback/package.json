{
  "name": "@tlberglund/handwriting-playback",
  "version": "0.3.1",
  "description": "Handwriting animation playback engine",
  "main": "dist/handwriting-animator.js",
  "module": "dist/handwriting-animator.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/handwriting-animator.esm.js",
      "require": "./dist/handwriting-animator.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "author": "Tim Berglund <tlberglund@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tlberglund/animated-handwriting"
  },
  "keywords": [
    "handwriting",
    "animation",
    "canvas",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --loader:.mp3=dataurl --outfile=dist/handwriting-animator.js --format=iife --global-name=HandwritingAnimatorLib",
    "build:esm": "esbuild src/index.ts --bundle --loader:.mp3=dataurl --outfile=dist/handwriting-animator.esm.js --format=esm",
    "build:types": "tsc --emitDeclarationOnly",
    "watch": "esbuild src/index.ts --bundle --loader:.mp3=dataurl --outfile=dist/handwriting-animator.js --format=iife --global-name=HandwritingAnimatorLib --watch"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
